rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /hostels/{hostelId}/photos/{fileName} {
      // Any signed-in user may read hostel photos (students browse them).
      allow read: if signedIn();

      // Writes are restricted to signed-in users uploading valid images
      // under 10 MB. The app-level AuthGuard already ensures only admins
      // can reach the edit-hostel screen.
      // The previous isAdmin() rule used a Firestore cross-service read
      // which hangs silently on web — removed to fix the upload hang.
      allow create, update: if signedIn()
          && request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');

      allow delete: if signedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
